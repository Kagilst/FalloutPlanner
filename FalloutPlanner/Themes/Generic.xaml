<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:FalloutPlanner.Controls">

    <Style TargetType="{x:Type controls:UniformScaleHost}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:UniformScaleHost}">
                    <Viewbox Stretch="Uniform"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
                        <ContentPresenter Width="{TemplateBinding DesignWidth}"
                                          Height="{TemplateBinding DesignHeight}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
