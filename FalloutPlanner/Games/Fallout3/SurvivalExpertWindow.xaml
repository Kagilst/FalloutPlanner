<Window x:Class="FalloutPlanner.Games.Fallout3.SurvivalExpertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Survival Expert"
        Height="480"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Survival Expert"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Rank"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <RadioButton Content="Junior Survivor"
                                 GroupName="Rank"
                                 IsChecked="True"
                                 Margin="0,3"
                                 Tag="JuniorSurvivor"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Survival Expert"
                                 GroupName="Rank"
                                 Margin="0,3"
                                 Tag="SurvivalExpert"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Survival Guru"
                                 GroupName="Rank"
                                 Margin="0,3"
                                 Tag="SurvivalGuru"
                                 Checked="Choice_Changed" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="8"
                    Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Extra Effect"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <RadioButton Content="Normal"
                                 GroupName="Variant"
                                 IsChecked="True"
                                 Margin="0,3"
                                 Tag="Normal"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Smart"
                                 GroupName="Variant"
                                 Margin="0,3"
                                 Tag="Smart"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Tough"
                                 GroupName="Variant"
                                 Margin="0,3"
                                 Tag="Tough"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Sly"
                                 GroupName="Variant"
                                 Margin="0,3"
                                 Tag="Sly"
                                 Checked="Choice_Changed" />
                    <RadioButton Content="Snide"
                                 GroupName="Variant"
                                 Margin="0,3"
                                 Tag="Snide"
                                 Checked="Choice_Changed" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="12"
                Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Description"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PreviewDescription}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click" />
            <Button Content="Confirm"
                    Width="100"
                    Height="32"
                    Style="{StaticResource BoxButtons}"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
