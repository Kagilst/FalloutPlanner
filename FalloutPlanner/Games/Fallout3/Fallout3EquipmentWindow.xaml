<Window x:Class="FalloutPlanner.Games.Fallout3.Fallout3EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment"
        Height="620"
        Width="1040"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout3Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Equipment"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Equipment slots -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                        BorderThickness="2"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Equip"
                                    Width="70"
                                    Height="26"
                                    Style="{StaticResource BoxButtons}"
                                    Click="EquipHeadwear_Click" />
                            <TextBlock Text="Headwear"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding HeadwearName}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HeadwearDetails}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.9" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                        BorderThickness="2"
                        Padding="10"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Equip"
                                    Width="70"
                                    Height="26"
                                    Style="{StaticResource BoxButtons}"
                                    Click="EquipEyewear_Click" />
                            <TextBlock Text="Eyewear"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding EyewearName}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EyewearDetails}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.9" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                        BorderThickness="2"
                        Padding="10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="Equip"
                                    Width="70"
                                    Height="26"
                                    Style="{StaticResource BoxButtons}"
                                    Click="EquipBody_Click" />
                            <TextBlock Text="Body"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding BodyName}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BodyDetails}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.9" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Character stats (equipment-affected only) -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- SPECIAL -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SPECIAL" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Strength}" DockPanel.Dock="Right"/><TextBlock Text="Strength:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Perception}" DockPanel.Dock="Right"/><TextBlock Text="Perception:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Endurance}" DockPanel.Dock="Right"/><TextBlock Text="Endurance:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Charisma}" DockPanel.Dock="Right"/><TextBlock Text="Charisma:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Intelligence}" DockPanel.Dock="Right"/><TextBlock Text="Intelligence:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Agility}" DockPanel.Dock="Right"/><TextBlock Text="Agility:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Luck}" DockPanel.Dock="Right"/><TextBlock Text="Luck:" FontWeight="Bold"/></DockPanel>
                        </StackPanel>

                        <!-- Stats -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stats" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Health}" DockPanel.Dock="Right"/><TextBlock Text="Health:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding ActionPoints}" DockPanel.Dock="Right"/><TextBlock Text="Action Points:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding CriticalChance}" DockPanel.Dock="Right"/><TextBlock Text="Critical Chance:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding DamageResist}" DockPanel.Dock="Right"/><TextBlock Text="Damage Resist:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding FireResist}" DockPanel.Dock="Right"/><TextBlock Text="Fire Resist:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding PoisonResist}" DockPanel.Dock="Right"/><TextBlock Text="Poison Resist:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding RadiationResist}" DockPanel.Dock="Right"/><TextBlock Text="Radiation Resist:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding MeleeDamage}" DockPanel.Dock="Right"/><TextBlock Text="Melee Damage:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding CarryWeight}" DockPanel.Dock="Right"/><TextBlock Text="Carry Weight:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding MovementDebuff}" DockPanel.Dock="Right"/><TextBlock Text="Movement Debuff:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding LoudnessDebuff}" DockPanel.Dock="Right"/><TextBlock Text="Loudness Debuff:" FontWeight="Bold"/></DockPanel>
                        </StackPanel>

                        <!-- Skills -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Skills" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Barter}" DockPanel.Dock="Right"/><TextBlock Text="Barter:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding BigGuns}" DockPanel.Dock="Right"/><TextBlock Text="Big Guns:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding EnergyWeapons}" DockPanel.Dock="Right"/><TextBlock Text="Energy Weapons:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Explosives}" DockPanel.Dock="Right"/><TextBlock Text="Explosives:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Lockpick}" DockPanel.Dock="Right"/><TextBlock Text="Lockpick:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Medicine}" DockPanel.Dock="Right"/><TextBlock Text="Medicine:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding MeleeWeapons}" DockPanel.Dock="Right"/><TextBlock Text="Melee Weapons:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Repair}" DockPanel.Dock="Right"/><TextBlock Text="Repair:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Science}" DockPanel.Dock="Right"/><TextBlock Text="Science:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding SmallGuns}" DockPanel.Dock="Right"/><TextBlock Text="Small Guns:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Sneak}" DockPanel.Dock="Right"/><TextBlock Text="Sneak:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Speech}" DockPanel.Dock="Right"/><TextBlock Text="Speech:" FontWeight="Bold"/></DockPanel>
                            <DockPanel Margin="0,2"><TextBlock Text="{Binding Unarmed}" DockPanel.Dock="Right"/><TextBlock Text="Unarmed:" FontWeight="Bold"/></DockPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="Back"
                Margin="0,12,0,0"
                Height="35"
                HorizontalAlignment="Left"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Back_Click" />
    </Grid>
</Window>
