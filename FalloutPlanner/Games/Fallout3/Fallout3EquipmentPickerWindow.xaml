<Window x:Class="FalloutPlanner.Games.Fallout3.Fallout3EquipmentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equip Item"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout3Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding SlotTitle}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,10" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="6" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Title}"
                                          IsExpanded="True"
                                          Margin="0,4"
                                          Foreground="{DynamicResource FalloutTextBrush}">
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4,4,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Margin="0,2"
                                                        HorizontalContentAlignment="Left"
                                                        Style="{StaticResource BoxButtons}"
                                                        Tag="{Binding}"
                                                        Click="Item_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedName}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="DR:" FontWeight="Bold" Margin="0,12,0,2"
                               Foreground="{DynamicResource FalloutAccentBrush}" />
                    <TextBlock Text="{Binding SelectedDR}" />
                    <TextBlock Text="Weight:" FontWeight="Bold" Margin="0,10,0,2"
                               Foreground="{DynamicResource FalloutAccentBrush}" />
                    <TextBlock Text="{Binding SelectedWeight}" TextWrapping="Wrap" />
                    <TextBlock Text="Effects:" FontWeight="Bold" Margin="0,10,0,2"
                               Foreground="{DynamicResource FalloutAccentBrush}" />
                    <TextBlock Text="{Binding SelectedEffects}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Unequip Slot"
                    Width="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource BoxButtons}"
                    Click="Unequip_Click" />
            <Button Content="Equip"
                    Width="100"
                    Height="32"
                    Margin="0,0,8,0"
                    Style="{StaticResource BoxButtons}"
                    IsEnabled="{Binding CanEquip}"
                    Click="Equip_Click" />
            <Button Content="Cancel"
                    Width="100"
                    Height="32"
                    Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
