<Window x:Class="FalloutPlanner.Games.Fallout3.Fallout3BobbleheadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bobbleheads"
        Height="520"
        Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout3Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BobbleListBox" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FalloutBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
            </Style>

            <Style x:Key="BobbleListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#122A17" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!-- Found -->
            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Found Bobbleheads"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FoundBobbleheads}"
                             SelectedItem="{Binding SelectedFound}"
                             Style="{StaticResource BobbleListBox}"
                             ItemContainerStyle="{StaticResource BobbleListBoxItem}"
                             DisplayMemberPath="Name"
                             SelectionChanged="FoundList_SelectionChanged" />
                    <TextBlock Grid.Row="1"
                               Text="None found yet."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowFoundEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- Not Found -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="8"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Not Found Bobbleheads"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NotFoundBobbleheads}"
                             SelectedItem="{Binding SelectedNotFound}"
                             Style="{StaticResource BobbleListBox}"
                             ItemContainerStyle="{StaticResource BobbleListBoxItem}"
                             DisplayMemberPath="Name"
                             SelectionChanged="NotFoundList_SelectionChanged" />
                    <TextBlock Grid.Row="1"
                               Text="All found."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowNotFoundEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedBobblehead.Name}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />

                            <TextBlock Text="Effect:"
                                       Margin="0,12,0,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />
                            <TextBlock Text="{Binding SelectedEffect}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Location:"
                                       Margin="0,12,0,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />
                            <TextBlock Text="{Binding SelectedLocation}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="1"
                            Content="Add to Found"
                            Margin="0,12,0,0"
                            Height="35"
                            Style="{StaticResource BoxButtons}"
                            Visibility="{Binding CanAddSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="AddToFound_Click" />
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="1"
                Content="Back"
                Margin="0,12,0,0"
                Height="35"
                HorizontalAlignment="Left"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Back_Click" />
    </Grid>
</Window>
