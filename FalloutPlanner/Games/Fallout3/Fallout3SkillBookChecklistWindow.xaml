<Window x:Class="FalloutPlanner.Games.Fallout3.Fallout3SkillBookChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill Book Checklist"
        Height="640"
        Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout3Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Skill Book Checklist"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,10" />

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded}"
                                      Margin="0,4"
                                      Foreground="{DynamicResource FalloutTextBrush}">
                                <Expander.Header>
                                    <TextBlock FontWeight="Bold"
                                               Foreground="{DynamicResource FalloutAccentBrush}">
                                        <Run Text="{Binding BookName, Mode=OneWay}" />
                                        <Run Text=" (" />
                                        <Run Text="{Binding FoundCount, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                                        <Run Text=")" />
                                    </TextBlock>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Locations}" Margin="12,6,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,3"
                                                      IsChecked="{Binding IsFound, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      Foreground="{Binding ForegroundBrush}">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding MapMarker, Mode=OneWay}" FontWeight="Bold" />
                                                    <LineBreak />
                                                    <Run Text="{Binding Description, Mode=OneWay}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2"
                Content="Back"
                Margin="0,12,0,0"
                Height="35"
                HorizontalAlignment="Left"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Back_Click" />
    </Grid>
</Window>
