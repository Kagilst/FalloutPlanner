<Window x:Class="FalloutPlanner.Games.Fallout3.Fallout3SkillBooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill Books"
        Height="560"
        Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout3Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="Checklist"
                    Width="110"
                    Height="32"
                    Style="{StaticResource BoxButtons}"
                    Click="Checklist_Click" />
            <TextBlock Text="Skill Books"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"
                       VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding ComprehensionNote}"
                   FontSize="12"
                   Opacity="0.85"
                   Margin="0,0,0,8" />

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="8"
                Margin="0,8,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Books}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding SkillLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CountDisplay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="3"
                                        Content="+"
                                        Width="28"
                                        Height="28"
                                        Style="{StaticResource SkillAdjustButton}"
                                        IsEnabled="{Binding CanIncrease}"
                                        Click="Increase_Click"
                                        Tag="{Binding}" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding MaxDisplay}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="3"
                Content="Back"
                Margin="0,12,0,0"
                Height="35"
                HorizontalAlignment="Left"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Back_Click" />
    </Grid>
</Window>
