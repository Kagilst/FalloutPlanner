<Window x:Class="FalloutPlanner.Games.Fallout3.AntMightSightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ant Might / Sight"
        Height="240"
        Width="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose Strength (Ant Might) or Perception (Ant Sight)"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="1">
            <Button x:Name="StrengthButton"
                    Content="Strength"
                    Margin="0,3"
                    Height="36"
                    Style="{StaticResource BoxButtons}"
                    Tag="Strength"
                    Click="Special_Click" />
            <Button x:Name="PerceptionButton"
                    Content="Perception"
                    Margin="0,3"
                    Height="36"
                    Style="{StaticResource BoxButtons}"
                    Tag="Perception"
                    Click="Special_Click" />
        </StackPanel>

        <Button Grid.Row="2"
                Content="Cancel"
                Margin="0,12,0,0"
                Height="32"
                HorizontalAlignment="Right"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Cancel_Click" />
    </Grid>
</Window>
