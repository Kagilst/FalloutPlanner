<Window x:Class="FalloutPlanner.Games.Fallout3.IntenseTrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intense Training"
        Height="360"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose one SPECIAL to increase by +1"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <UniformGrid Grid.Row="1" Rows="7" Columns="1">
            <Button x:Name="StrengthButton" Content="Strength" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Strength" Click="Special_Click" />
            <Button x:Name="PerceptionButton" Content="Perception" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Perception" Click="Special_Click" />
            <Button x:Name="EnduranceButton" Content="Endurance" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Endurance" Click="Special_Click" />
            <Button x:Name="CharismaButton" Content="Charisma" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Charisma" Click="Special_Click" />
            <Button x:Name="IntelligenceButton" Content="Intelligence" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Intelligence" Click="Special_Click" />
            <Button x:Name="AgilityButton" Content="Agility" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Agility" Click="Special_Click" />
            <Button x:Name="LuckButton" Content="Luck" Margin="0,3" Style="{StaticResource BoxButtons}" Tag="Luck" Click="Special_Click" />
        </UniformGrid>

        <Button Grid.Row="2"
                Content="Cancel"
                Margin="0,12,0,0"
                Height="32"
                HorizontalAlignment="Right"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Cancel_Click" />
    </Grid>
</Window>
