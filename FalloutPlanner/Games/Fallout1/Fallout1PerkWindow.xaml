<Window x:Class="FalloutPlanner.Games.Fallout1.Fallout1PerkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Perk" Height="500" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C08">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout1Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Text="PICK A PERK" Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource FalloutAccentBrush}"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Perk List -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource FalloutBorderBrush}" 
                BorderThickness="2" Padding="5" Margin="0,0,5,0">
            <ListBox x:Name="PerksList" Style="{StaticResource FO1ListBox}"
                     SelectionChanged="PerksList_SelectionChanged"
                     ItemContainerStyle="{StaticResource FO1ListBoxItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Description Panel (Parchment style) -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DescriptionPanel}" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PerkTitle" Text="PERK INFO" 
                           Foreground="{StaticResource FalloutDescriptionTextBrush}"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

                <TextBlock x:Name="PerkRequirements" Grid.Row="1"
                           Foreground="{StaticResource FalloutDescriptionTextBrush}"
                           FontStyle="Italic" FontSize="11" Margin="0,0,0,10"
                           Text="Requirements: None"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PerkDescription" 
                               Foreground="{StaticResource FalloutDescriptionTextBrush}"
                               TextWrapping="Wrap"
                               Text="Select a perk to see its description."/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click" Margin="0,0,5,0" Padding="15,5"/>
            <Button x:Name="SelectButton" Content="Select" Grid.Column="1" Style="{StaticResource BoxButtons}"
                    Click="Select_Click" Margin="5,0,0,0" Padding="15,5" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
