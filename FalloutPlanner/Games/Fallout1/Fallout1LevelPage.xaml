<Page x:Class="FalloutPlanner.Games.Fallout1.Fallout1LevelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Fallout 1 Level Page">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout1Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{DynamicResource FalloutBackgroundBrush}" MinWidth="750" MinHeight="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,5">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource FalloutAccentBrush}" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text=" - Level " Foreground="{StaticResource FalloutAccentBrush}" FontSize="18"/>
            <TextBlock Text="{Binding Level}" Foreground="{StaticResource FalloutAccentBrush}" FontSize="18" FontWeight="Bold"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15,5,15,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: SPECIAL + Derived -->
            <Border Grid.Column="0" BorderBrush="{StaticResource FalloutBorderBrush}" BorderThickness="2" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SPECIAL -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="S.P.E.C.I.A.L." Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Strength:" Grid.Row="0" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Strength}" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Perception:" Grid.Row="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Perception}" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Endurance:" Grid.Row="2" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Endurance}" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Charisma:" Grid.Row="3" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Charisma}" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Intelligence:" Grid.Row="4" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Intelligence}" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Agility:" Grid.Row="5" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Agility}" Grid.Row="5" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Luck:" Grid.Row="6" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Luck}" Grid.Row="6" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                        </Grid>

                        <!-- Derived Stats -->
                        <TextBlock Text="DERIVED STATS" Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Margin="0,15,0,5"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Hit Points:" Grid.Row="0" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding HitPoints}" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Armor Class:" Grid.Row="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding ArmorClass}" Grid.Row="1" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Action Points:" Grid.Row="2" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding ActionPoints}" Grid.Row="2" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Carry Weight:" Grid.Row="3" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding CarryWeight}" Grid.Row="3" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Melee Damage:" Grid.Row="4" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding MeleeDamage}" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Damage Resist:" Grid.Row="5" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding DamageResistance, StringFormat={}{0}%}" Grid.Row="5" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Poison Resist:" Grid.Row="6" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding PoisonResistance, StringFormat={}{0}%}" Grid.Row="6" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Rad Resist:" Grid.Row="7" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding RadiationResistance, StringFormat={}{0}%}" Grid.Row="7" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Sequence:" Grid.Row="8" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding Sequence}" Grid.Row="8" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Healing Rate:" Grid.Row="9" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding HealingRate}" Grid.Row="9" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="Critical Chance:" Grid.Row="10" Foreground="{StaticResource FalloutTextBrush}"/>
                            <TextBlock Text="{Binding CriticalChance, StringFormat={}{0}%}" Grid.Row="10" Grid.Column="1" Foreground="{StaticResource FalloutTextBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- History -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource FalloutBorderBrush}" 
                            BorderThickness="1" Margin="0,10,0,0" Padding="5">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="HISTORY" 
                                       Foreground="{StaticResource FalloutAccentBrush}" 
                                       FontWeight="Bold" Margin="0,0,0,4"/>
                            <ListBox ItemsSource="{Binding ActionLog}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource FalloutTextBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontSize="10">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="2,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource FalloutTextBrush}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Middle Column: Skills -->
            <Border Grid.Column="1" BorderBrush="{StaticResource FalloutBorderBrush}" BorderThickness="2" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="SKILLS" Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Grid.Row="0"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Skill Points: " Foreground="{StaticResource FalloutAccentBrush}"/>
                        <TextBlock Text="{Binding SkillPoints}" Foreground="{StaticResource FalloutTextBrush}" FontWeight="Bold"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="SkillsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Skills with +/- buttons -->
                            <TextBlock Text="Small Guns:" Grid.Row="0" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="0" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="SmallGuns" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseSmallGuns}"/>
                            <TextBlock Text="{Binding SmallGuns, StringFormat={}{0}%}" Grid.Row="0" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="0" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="SmallGuns" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseSmallGuns}"/>

                            <TextBlock Text="Big Guns:" Grid.Row="1" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="1" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="BigGuns" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseBigGuns}"/>
                            <TextBlock Text="{Binding BigGuns, StringFormat={}{0}%}" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="1" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="BigGuns" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseBigGuns}"/>

                            <TextBlock Text="Energy Weapons:" Grid.Row="2" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="2" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="EnergyWeapons" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseEnergyWeapons}"/>
                            <TextBlock Text="{Binding EnergyWeapons, StringFormat={}{0}%}" Grid.Row="2" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="2" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="EnergyWeapons" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseEnergyWeapons}"/>

                            <TextBlock Text="Unarmed:" Grid.Row="3" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="3" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Unarmed" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseUnarmed}"/>
                            <TextBlock Text="{Binding Unarmed, StringFormat={}{0}%}" Grid.Row="3" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="3" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Unarmed" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseUnarmed}"/>

                            <TextBlock Text="Melee Weapons:" Grid.Row="4" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="4" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="MeleeWeapons" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseMeleeWeapons}"/>
                            <TextBlock Text="{Binding MeleeWeapons, StringFormat={}{0}%}" Grid.Row="4" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="4" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="MeleeWeapons" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseMeleeWeapons}"/>

                            <TextBlock Text="Throwing:" Grid.Row="5" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="5" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Throwing" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseThrowing}"/>
                            <TextBlock Text="{Binding Throwing, StringFormat={}{0}%}" Grid.Row="5" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="5" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Throwing" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseThrowing}"/>

                            <TextBlock Text="First Aid:" Grid.Row="6" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="6" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="FirstAid" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseFirstAid}"/>
                            <TextBlock Text="{Binding FirstAid, StringFormat={}{0}%}" Grid.Row="6" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="6" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="FirstAid" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseFirstAid}"/>

                            <TextBlock Text="Doctor:" Grid.Row="7" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="7" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Doctor" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseDoctor}"/>
                            <TextBlock Text="{Binding Doctor, StringFormat={}{0}%}" Grid.Row="7" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="7" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Doctor" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseDoctor}"/>

                            <TextBlock Text="Sneak:" Grid.Row="8" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="8" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Sneak" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseSneak}"/>
                            <TextBlock Text="{Binding Sneak, StringFormat={}{0}%}" Grid.Row="8" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="8" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Sneak" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseSneak}"/>

                            <TextBlock Text="Lockpick:" Grid.Row="9" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="9" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Lockpick" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseLockpick}"/>
                            <TextBlock Text="{Binding Lockpick, StringFormat={}{0}%}" Grid.Row="9" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="9" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Lockpick" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseLockpick}"/>

                            <TextBlock Text="Steal:" Grid.Row="10" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="10" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Steal" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseSteal}"/>
                            <TextBlock Text="{Binding Steal, StringFormat={}{0}%}" Grid.Row="10" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="10" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Steal" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseSteal}"/>

                            <TextBlock Text="Traps:" Grid.Row="11" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="11" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Traps" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseTraps}"/>
                            <TextBlock Text="{Binding Traps, StringFormat={}{0}%}" Grid.Row="11" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="11" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Traps" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseTraps}"/>

                            <TextBlock Text="Science:" Grid.Row="12" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="12" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Science" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseScience}"/>
                            <TextBlock Text="{Binding Science, StringFormat={}{0}%}" Grid.Row="12" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="12" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Science" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseScience}"/>

                            <TextBlock Text="Repair:" Grid.Row="13" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="13" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Repair" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseRepair}"/>
                            <TextBlock Text="{Binding Repair, StringFormat={}{0}%}" Grid.Row="13" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="13" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Repair" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseRepair}"/>

                            <TextBlock Text="Speech:" Grid.Row="14" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="14" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Speech" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseSpeech}"/>
                            <TextBlock Text="{Binding Speech, StringFormat={}{0}%}" Grid.Row="14" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="14" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Speech" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseSpeech}"/>

                            <TextBlock Text="Barter:" Grid.Row="15" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="15" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Barter" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseBarter}"/>
                            <TextBlock Text="{Binding Barter, StringFormat={}{0}%}" Grid.Row="15" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="15" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Barter" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseBarter}"/>

                            <TextBlock Text="Gambling:" Grid.Row="16" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="16" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Gambling" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseGambling}"/>
                            <TextBlock Text="{Binding Gambling, StringFormat={}{0}%}" Grid.Row="16" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="16" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Gambling" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseGambling}"/>

                            <TextBlock Text="Outdoorsman:" Grid.Row="17" Foreground="{StaticResource FalloutTextBrush}" VerticalAlignment="Center"/>
                            <Button Content="-" Grid.Row="17" Grid.Column="1" Style="{StaticResource SkillAdjustButton}" Tag="Outdoorsman" Click="DecreaseSkill_Click" IsEnabled="{Binding CanDecreaseOutdoorsman}"/>
                            <TextBlock Text="{Binding Outdoorsman, StringFormat={}{0}%}" Grid.Row="17" Grid.Column="2" Foreground="{StaticResource FalloutTextBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button Content="+" Grid.Row="17" Grid.Column="3" Style="{StaticResource SkillAdjustButton}" Tag="Outdoorsman" Click="IncreaseSkill_Click" IsEnabled="{Binding CanIncreaseOutdoorsman}"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Column: Perks + Traits + Info -->
            <Border Grid.Column="2" BorderBrush="{StaticResource FalloutBorderBrush}" BorderThickness="2" Margin="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="PERKS &amp; TRAITS" Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Grid.Row="0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,5">
                        <StackPanel>
                            <TextBlock Text="Traits:" Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Margin="0,0,0,3"/>
                            <ItemsControl ItemsSource="{Binding Traits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource FalloutTextBrush}" Margin="10,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Perks:" Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold" Margin="0,10,0,3"/>
                            <ItemsControl ItemsSource="{Binding OwnedPerkNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource FalloutTextBrush}" Margin="10,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <TextBlock Foreground="{StaticResource FalloutTextBrush}" TextWrapping="Wrap" FontSize="11">
                            <Run Text="Perk every "/>
                            <Run Text="{Binding PerkInterval, Mode=OneWay}"/>
                            <Run Text=" levels"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource FalloutTextBrush}" TextWrapping="Wrap" FontSize="11">
                            <Run Text="Next perk level: "/>
                            <Run x:Name="NextPerkLevel"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2" Margin="15,5,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Undo" Grid.Column="0" Style="{StaticResource BoxButtons}"
                    Click="Undo_Click" Margin="2"/>

            <Button Content="Equipment" Grid.Column="1" Style="{StaticResource BoxButtons}"
                    Click="Equipment_Click" Margin="2"/>

            <Button Content="Skill Books" Grid.Column="2" Style="{StaticResource BoxButtons}"
                    Click="SkillBooks_Click" Margin="2"/>

            <Button Content="Perks" Grid.Column="3" Style="{StaticResource BoxButtons}"
                    Click="Perks_Click" Margin="2"/>

            <Button Content="Level Up" Grid.Column="4" Style="{StaticResource BoxButtons}"
                    Click="LevelUp_Click" Margin="2"
                    IsEnabled="{Binding CanLevelUp}"/>
        </Grid>
    </Grid>
</Page>
