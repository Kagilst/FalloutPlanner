<Window x:Class="FalloutPlanner.Games.Fallout1.Fallout1OwnedPerksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owned Perks" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C08">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout1Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Text="OWNED PERKS" Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource FalloutAccentBrush}"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Perk List -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource FalloutBorderBrush}" 
                BorderThickness="2" Padding="5" Margin="0,0,5,0">
            <ListBox x:Name="PerksList" Style="{StaticResource FO1ListBox}"
                     SelectionChanged="PerksList_SelectionChanged"
                     ItemContainerStyle="{StaticResource FO1ListBoxItem}"/>
        </Border>

        <!-- Description Panel -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DescriptionPanel}" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PerkTitle" Text="PERK INFO" 
                           Foreground="{StaticResource FalloutDescriptionTextBrush}"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="PerkDescription" 
                               Foreground="{StaticResource FalloutDescriptionTextBrush}"
                               TextWrapping="Wrap"
                               Text="Select a perk to see its description."/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Close Button -->
        <Button Content="Close" Grid.Row="2" Grid.ColumnSpan="2" 
                Style="{StaticResource BoxButtons}"
                Click="Close_Click" Margin="0,10,0,0" Padding="15,5"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
