<Window x:Class="FalloutPlanner.Games.Fallout1.Fallout1EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C08">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout1Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="EQUIPMENT" Grid.Row="0"
                   Foreground="{StaticResource FalloutAccentBrush}"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Coming Soon message -->
        <Border Grid.Row="1" BorderBrush="{StaticResource FalloutBorderBrush}" 
                BorderThickness="2" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="COMING SOON" 
                           Foreground="{StaticResource FalloutAccentBrush}"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Equipment tracking will be added in a future update." 
                           Foreground="{StaticResource FalloutTextBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Close Button -->
        <Button Content="Close" Grid.Row="2" Style="{StaticResource BoxButtons}"
                Click="Close_Click" Margin="0,10,0,0" Padding="15,5"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>
