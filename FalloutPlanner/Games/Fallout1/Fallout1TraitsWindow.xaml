<Window x:Class="FalloutPlanner.Fallout1TraitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Traits" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A0C08">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout1Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <TextBlock Text="SELECT TRAITS" Grid.Row="0" Grid.ColumnSpan="2"
                   Foreground="{StaticResource FalloutAccentBrush}"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Traits List -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource FalloutBorderBrush}" 
                BorderThickness="2" Padding="5" Margin="0,0,5,0">
            <ListBox x:Name="TraitsList" Style="{StaticResource FO1ListBox}"
                     SelectionChanged="TraitsList_SelectionChanged"
                     ItemContainerStyle="{StaticResource FO1ListBoxItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Style="{StaticResource TraitCheckBox}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="Trait_CheckChanged"
                                      Unchecked="Trait_CheckChanged"
                                      Tag="{Binding Name}"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Description Panel -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DescriptionPanel}" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TraitTitle" Text="TRAIT INFO" 
                           Foreground="{StaticResource FalloutDescriptionTextBrush}"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TraitDescription" 
                               Foreground="{StaticResource FalloutDescriptionTextBrush}"
                               TextWrapping="Wrap"
                               Text="Select a trait to see its description."/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Selected Traits Count -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Selected: " Foreground="{StaticResource FalloutAccentBrush}" FontWeight="Bold"/>
            <TextBlock x:Name="SelectedCount" Text="0" Foreground="{StaticResource FalloutTextBrush}"/>
            <TextBlock Text="/2" Foreground="{StaticResource FalloutTextBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Cancel" Grid.Column="0" Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click" Margin="0,0,5,0" Padding="15,5"/>
            <Button Content="OK" Grid.Column="1" Style="{StaticResource BoxButtons}"
                    Click="OK_Click" Margin="5,0,0,0" Padding="15,5"/>
        </Grid>
    </Grid>
</Window>
