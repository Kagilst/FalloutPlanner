<Window x:Class="FalloutPlanner.Games.Fallout4.Fallout4MagazinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magazines"
        Height="580"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout4Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MagListBox" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FalloutBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
            </Style>

            <Style x:Key="MagListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0E2A33" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MagComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MagComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FalloutBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource MagComboBoxItem}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome"
                                                    Background="{DynamicResource FalloutPanelBrush}"
                                                    BorderBrush="{DynamicResource FalloutBorderBrush}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="22"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1" Background="{DynamicResource FalloutPanelBrush}"
                                                            BorderBrush="{DynamicResource FalloutBorderBrush}" BorderThickness="1,0,0,0">
                                                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                              Fill="{DynamicResource FalloutAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Margin="8,4,28,4"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  RecognizesAccessKey="True"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  TextElement.Foreground="{DynamicResource FalloutTextBrush}"/>

                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="{DynamicResource FalloutPanelBrush}"
                                                BorderBrush="{DynamicResource FalloutBorderBrush}"
                                                BorderThickness="1">
                                            <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Magazines" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Collected -->
            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Collected" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="CollectedList" Grid.Row="1"
                             ItemsSource="{Binding Collected}"
                             SelectedItem="{Binding SelectedCollected}"
                             Style="{StaticResource MagListBox}"
                             ItemContainerStyle="{StaticResource MagListBoxItem}"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="CollectedList_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Text="None collected yet."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ShowCollectedEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Available series -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Find Magazines" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="SeriesList" Grid.Row="1"
                             ItemsSource="{Binding SeriesRows}"
                             SelectedItem="{Binding SelectedSeries}"
                             Style="{StaticResource MagListBox}"
                             ItemContainerStyle="{StaticResource MagListBoxItem}"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="SeriesList_SelectionChanged"/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <!-- Unique issue dropdown -->
                        <StackPanel Visibility="{Binding ShowIssuePicker, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Issue:" FontWeight="Bold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource FalloutAccentBrush}"/>
                            <ComboBox ItemsSource="{Binding AvailableIssues}"
                                      SelectedItem="{Binding SelectedIssue}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource MagComboBox}"/>
                            <Button Content="Collect Issue" Margin="0,8,0,0" Height="32"
                                    Style="{StaticResource BoxButtons}"
                                    IsEnabled="{Binding CanCollectIssue}"
                                    Click="CollectIssue_Click"/>
                        </StackPanel>

                        <!-- Stacking + -->
                        <StackPanel Visibility="{Binding ShowStackControls, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding StackProgressText}" Margin="0,0,0,6" Opacity="0.9"/>
                            <Button Content="Collect Copy" Height="32"
                                    Style="{StaticResource BoxButtons}"
                                    IsEnabled="{Binding CanCollectStack}"
                                    Click="CollectStack_Click"/>
                        </StackPanel>

                        <!-- You're SPECIAL! -->
                        <StackPanel Visibility="{Binding ShowYoureSpecial, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.9"
                                       Text="Gain +1 to a SPECIAL of your choice."/>
                            <Button Content="Collect You're SPECIAL!" Height="32"
                                    Style="{StaticResource BoxButtons}"
                                    IsEnabled="{Binding CanCollectYoureSpecial}"
                                    Click="CollectYoureSpecial_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Description -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Description:" Margin="0,12,0,4" FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"/>
                        <TextBlock Text="{Binding DetailDescription}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="2" Content="Back" Margin="0,12,0,0" Height="35"
                HorizontalAlignment="Left" Width="100"
                Style="{StaticResource BoxButtons}" Click="Back_Click"/>
    </Grid>
</Window>
