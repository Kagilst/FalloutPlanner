<Page x:Class="FalloutPlanner.Fallout4Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:FalloutPlanner.Controls"
      Title="Fallout 4"
      MinWidth="560"
      MinHeight="380">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout4Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <controls:UniformScaleHost DesignWidth="720" DesignHeight="480">
    <Grid Background="{DynamicResource FalloutBackgroundBrush}">
        <TextBlock Text="CHARACTER CREATION"
                   Margin="30,10,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"/>

        <Button Content="Characters"
                Margin="0,8,30,0"
                Padding="12,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource BoxButtons}"
                Click="Characters_Click"/>

        <Border Margin="30,40,30,50"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SPECIAL allocation: start at 1, spend 21, clamp 1-10 -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="S.P.E.C.I.A.L."
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Strength" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Strength" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseStrengthCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Strength}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Strength" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseStrengthCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Perception" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Perception" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreasePerceptionCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Perception}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Perception" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreasePerceptionCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Endurance" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Endurance" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseEnduranceCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Endurance}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Endurance" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseEnduranceCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Charisma" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Charisma" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseCharismaCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Charisma}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Charisma" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseCharismaCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intelligence" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Intelligence" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseIntelligenceCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Intelligence}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Intelligence" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseIntelligenceCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Agility" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Agility" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseAgilityCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Agility}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Agility" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseAgilityCreation}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="30"/><ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Luck" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="-" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Luck" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanDecreaseLuckCreation}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Luck}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="+" Style="{StaticResource DecreaseIncreaseButton}"
                                Tag="Luck" Click="ModifySpecial_Click"
                                IsEnabled="{Binding CanIncreaseLuckCreation}"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/><ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Points Left" FontWeight="Bold" Foreground="{DynamicResource FalloutAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Points}" FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="DERIVED STATS"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,10"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hit Points" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding HitPoints}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action Points" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding ActionPoints}"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Carry Weight" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding CarryWeight}"/>
                    </Grid>

                    <TextBlock TextWrapping="Wrap" Margin="0,20,0,0" Opacity="0.85"
                               Text="Each SPECIAL starts at 1. Spend all 21 points (max 10 per stat), then name your character to begin leveling. Each level grants 1 perk point for a SPECIAL increase or a perk rank."/>
                </StackPanel>
            </Grid>
        </Border>

        <Button Content="Return"
                Margin="30,0,0,12"
                Padding="12,4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Style="{StaticResource BoxButtons}"
                Click="BackButton_Click"/>

        <Button Content="Create Character"
                Margin="0,0,30,12"
                Padding="12,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource BoxButtons}"
                IsEnabled="{Binding CanConfirmCreation}"
                Click="CreateCharacter_Click"/>
    </Grid>
    </controls:UniformScaleHost>
</Page>
