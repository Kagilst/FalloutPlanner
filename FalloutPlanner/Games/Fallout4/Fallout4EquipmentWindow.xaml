<Window x:Class="FalloutPlanner.Games.Fallout4.Fallout4EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout4Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="12">
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right"
                    Style="{StaticResource BoxButtons}" Click="Close_Click" Margin="0,12,0,0"/>
            <StackPanel>
                <TextBlock Text="Equipment" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Armor and weapon loadouts will be added here. Temporary SPECIAL from gear does not unlock perk chart requirements."/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
