<Window x:Class="FalloutPlanner.Games.Fallout4.Fallout4CharacterNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Character Name"
        Height="150"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout4Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="15"
            BorderBrush="{DynamicResource FalloutAccentBrush}"
            BorderThickness="2"
            Padding="10"
            Background="{DynamicResource FalloutPanelBrush}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox x:Name="NameTextBox"
                     Width="150"
                     MaxLength="16"
                     VerticalAlignment="Center"
                     Background="{DynamicResource FalloutBackgroundBrush}"
                     Foreground="{DynamicResource FalloutTextBrush}"
                     BorderBrush="{DynamicResource FalloutBorderBrush}"
                     CaretBrush="{DynamicResource FalloutAccentBrush}"
                     TextChanged="NameTextBox_TextChanged"/>
            <Button x:Name="ConfirmButton"
                    Content="Confirm"
                    Margin="10,0,0,0"
                    Padding="10,4"
                    IsEnabled="False"
                    Click="ConfirmButton_Click"
                    Style="{StaticResource BoxButtons}"/>
        </StackPanel>
    </Border>
</Window>
