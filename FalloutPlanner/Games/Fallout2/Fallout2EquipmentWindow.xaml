<Window x:Class="FalloutPlanner.Games.Fallout2.Fallout2EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout2Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Equipment"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Coming Soon"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource FalloutAccentBrush}"/>
                <TextBlock Text="Equipment management will be added in a future update."
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource FalloutParchmentBrush}"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Content="Close" Width="80" Height="30"
                Margin="0,15,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource BoxButtons}"
                Click="Close_Click"/>
    </Grid>
</Window>
