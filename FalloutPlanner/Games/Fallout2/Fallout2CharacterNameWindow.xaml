<Window x:Class="FalloutPlanner.Games.Fallout2.Fallout2CharacterNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Character Setup"
        Height="280"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout2Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter Character Details"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,15"/>

        <!-- Name -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Name:" Width="60" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="NameInput"
                     Width="200"
                     Background="{DynamicResource FalloutPanelBrush}"
                     Foreground="{DynamicResource FalloutTextBrush}"
                     BorderBrush="{DynamicResource FalloutBorderBrush}"
                     Padding="5,3"
                     MaxLength="32"/>
        </StackPanel>

        <!-- Age -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Age:" Width="60" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="AgeInput"
                     Width="60"
                     Text="25"
                     Background="{DynamicResource FalloutPanelBrush}"
                     Foreground="{DynamicResource FalloutTextBrush}"
                     BorderBrush="{DynamicResource FalloutBorderBrush}"
                     Padding="5,3"
                     MaxLength="2"/>
            <TextBlock Text="(16-65)" Margin="10,0,0,0" VerticalAlignment="Center" FontStyle="Italic"
                       Foreground="{DynamicResource FalloutParchmentBrush}"/>
        </StackPanel>

        <!-- Gender -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Gender:" Width="60" VerticalAlignment="Center" FontWeight="Bold"/>
            <RadioButton x:Name="MaleRadio" Content="Male" IsChecked="True"
                         Foreground="{DynamicResource FalloutTextBrush}" Margin="0,0,15,0"/>
            <RadioButton x:Name="FemaleRadio" Content="Female"
                         Foreground="{DynamicResource FalloutTextBrush}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80"
                    Height="30"
                    Margin="0,0,10,0"
                    Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click"/>
            <Button Content="Continue"
                    Width="80"
                    Height="30"
                    Style="{StaticResource BoxButtons}"
                    Click="Continue_Click"/>
        </StackPanel>
    </Grid>
</Window>
