<Page x:Class="FalloutPlanner.Fallout2Window"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Fallout 2">

    <!-- Merge FO2 resources -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout2Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{DynamicResource FalloutBackgroundBrush}"
          MinWidth="720"
          MinHeight="500">
        <!-- Return Button Bottom Left -->
        <Button Content="Return"
                Margin="30,0,0,10"
                Padding="12,4"
                HorizontalAlignment="Left"
                Click="BackButton_Click"
                Style="{StaticResource BoxButtons}"
                VerticalAlignment="Bottom"/>

        <!-- Header -->
        <TextBlock Text="Character Creation"
                   Margin="30,10,0,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{StaticResource FalloutAccentBrush}"/>

        <!-- Main Frame -->
        <Border Margin="30,35,30,45" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8">
            <Grid x:Name="MainPanel">
                <Grid.ColumnDefinitions>
                    <!-- SPECIAL Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Derived Stats Column -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Skills Column -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- SPECIAL Panel -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="SPECIAL" FontWeight="Bold" Foreground="{StaticResource FalloutAccentBrush}" Margin="0,0,0,8"/>
                    
                    <!-- Strength -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Strength:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Strength" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Strength}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Strength" Click="ModifySpecial_Click"/>
                    </Grid>
                    
                    <!-- Perception -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Perception:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Perception" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Perception}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Perception" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Endurance -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Endurance:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Endurance" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Endurance}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Endurance" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Charisma -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Charisma:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Charisma" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Charisma}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Charisma" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Intelligence -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Intelligence:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Intelligence" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Intelligence}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Intelligence" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Agility -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Agility:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Agility" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Agility}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Agility" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Luck -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Luck:" VerticalAlignment="Center" FontWeight="Bold"/>
                        <Button Content="-" Grid.Column="1" Style="{StaticResource DecreaseIncreaseButton}" Tag="Luck" Click="ModifySpecial_Click"/>
                        <TextBlock Text="{Binding Luck}" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Grid.Column="3" Style="{StaticResource DecreaseIncreaseButton}" Tag="Luck" Click="ModifySpecial_Click"/>
                    </Grid>

                    <!-- Points Remaining -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Points:" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource FalloutAccentBrush}"/>
                        <TextBlock Text="{Binding Points}" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource FalloutAccentBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Derived Stats Panel -->
                <StackPanel Grid.Column="1" Margin="20,0">
                    <TextBlock Text="Derived Stats" FontWeight="Bold" Foreground="{StaticResource FalloutAccentBrush}" Margin="0,0,0,8"/>
                    
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Hit Points:" FontWeight="Bold"/><TextBlock Text="{Binding MaxHitPoints}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Action Points:" FontWeight="Bold"/><TextBlock Text="{Binding ActionPoints}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Armor Class:" FontWeight="Bold"/><TextBlock Text="{Binding ArmorClass}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Melee Dmg:" FontWeight="Bold"/><TextBlock Text="{Binding MeleeDamage}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Carry Weight:" FontWeight="Bold"/><TextBlock Text="{Binding CarryWeight}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Sequence:" FontWeight="Bold"/><TextBlock Text="{Binding Sequence}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Healing Rate:" FontWeight="Bold"/><TextBlock Text="{Binding HealingRate}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Crit Chance:" FontWeight="Bold"/><TextBlock Text="{Binding CriticalChance, StringFormat={}{0}%}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Poison Res:" FontWeight="Bold"/><TextBlock Text="{Binding PoisonResist, StringFormat={}{0}%}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Rad Res:" FontWeight="Bold"/><TextBlock Text="{Binding RadiationResist, StringFormat={}{0}%}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Skill Pts/Lvl:" FontWeight="Bold"/><TextBlock Text="{Binding SkillPointsPerLevel}" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tagged:" FontWeight="Bold" Foreground="{StaticResource FalloutAccentBrush}"/><TextBlock Text="{Binding TaggedSkills}" Grid.Column="1" Foreground="{StaticResource FalloutAccentBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Skills Panel -->
                <Grid Grid.Column="2" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Skills (Tag 3)" FontWeight="Bold" Foreground="{StaticResource FalloutAccentBrush}" Margin="0,0,0,8"/>
                    
                    <Grid Grid.Row="1" x:Name="SkillsPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left column skills -->
                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="SmallGuns" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Small Guns:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding SmallGuns, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="BigGuns" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Big Guns:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding BigGuns, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="EnergyWeapons" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Energy:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding EnergyWeapons, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Unarmed" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Unarmed:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Unarmed, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="MeleeWeapons" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Melee:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding MeleeWeapons, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Throwing" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Throwing:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Throwing, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="FirstAid" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="First Aid:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding FirstAid, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Doctor" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Doctor:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Doctor, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Sneak" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Sneak:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Sneak, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                        </StackPanel>
                        
                        <!-- Right column skills -->
                        <StackPanel Grid.Column="1">
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Lockpick" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Lockpick:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Lockpick, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Steal" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Steal:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Steal, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Traps" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Traps:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Traps, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Science" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Science:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Science, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Repair" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Repair:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Repair, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Speech" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Speech:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Speech, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Barter" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Barter:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Barter, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Gambling" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Gambling:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Gambling, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <ToggleButton Tag="Outdoorsman" Style="{StaticResource TAG}" Checked="TagSkill_Toggled" Unchecked="TagSkill_Toggled"/>
                                <TextBlock Text="Outdoorsman:" Grid.Column="1" FontWeight="Bold"/><TextBlock Text="{Binding Outdoorsman, StringFormat={}{0}%}" Grid.Column="2"/></Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Confirm button bottom right -->
        <Button Content="Done"
                Margin="0,0,30,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource BoxButtons}"
                Click="CreateChar_Click"
                Padding="12,4" 
                IsEnabled="{Binding CanConfirm}"/>
    </Grid>
</Page>

