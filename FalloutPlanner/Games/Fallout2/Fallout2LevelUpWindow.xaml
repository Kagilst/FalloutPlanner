<Window x:Class="FalloutPlanner.Games.Fallout2.Fallout2LevelUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a Perk"
        Height="520"
        Width="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout2Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PerkListBox" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FalloutBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
                <Setter Property="Padding" Value="4" />
            </Style>

            <Style x:Key="PerkListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#122A17" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDE: Perk List -->
        <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="4">
            <ListBox ItemsSource="{Binding PerkChoices}"
                     SelectedItem="{Binding SelectedChoice}"
                     Style="{StaticResource PerkListBox}"
                     ItemContainerStyle="{StaticResource PerkListBoxItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="Bold"
                                   Opacity="{Binding ListOpacity}"
                                   Foreground="{Binding ListForeground}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- RIGHT SIDE: Details -->
        <Border Grid.Column="1"
                Margin="15,0,0,0"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SelectedChoice.DisplayName}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource FalloutAccentBrush}" />

                <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Requirements:"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}" />
                        <TextBlock Text="{Binding SelectedRequirementsText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource FalloutParchmentBrush}"
                                   Margin="0,5,0,0" />

                        <TextBlock Text="Ranks:"
                                   Margin="0,15,0,5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"
                                   Visibility="{Binding ShowRanks, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding SelectedRanksText}"
                                   Foreground="{DynamicResource FalloutParchmentBrush}"
                                   Visibility="{Binding ShowRanks, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <TextBlock Text="Benefit:"
                                   Margin="0,15,0,5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}" />
                        <TextBlock Text="{Binding SelectedDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource FalloutParchmentBrush}"/>

                        <TextBlock Text="{Binding AvailabilityNote}"
                                   Margin="0,15,0,0"
                                   TextWrapping="Wrap"
                                   FontStyle="Italic"
                                   Foreground="#88AA66" />
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Content="Confirm Perk"
                        Margin="0,25,0,0"
                        Height="35"
                        Style="{StaticResource BoxButtons}"
                        IsEnabled="{Binding CanConfirmSelected}"
                        Click="Confirm_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
