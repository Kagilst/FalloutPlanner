<Window x:Class="FalloutPlanner.Games.Fallout2.Fallout2PerksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Owned Perks"
        Height="450"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Fallout2Resources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Owned Perks"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Perk List -->
            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="4" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding OwnedPerks}"
                         SelectedItem="{Binding SelectedPerk}"
                         Background="{DynamicResource FalloutPanelBrush}"
                         BorderThickness="0"
                         Foreground="{DynamicResource FalloutTextBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#122A17"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Perk Details -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedPerk.DisplayName}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"/>

                        <TextBlock Text="Description:"
                                   Margin="0,15,0,4"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"/>
                        <TextBlock Text="{Binding SelectedPerk.Perk.Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource FalloutParchmentBrush}"/>

                        <TextBlock Text="Ranks:"
                                   Margin="0,15,0,4"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"
                                   Visibility="{Binding ShowRanks, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding RanksText}"
                                   Foreground="{DynamicResource FalloutParchmentBrush}"
                                   Visibility="{Binding ShowRanks, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="2" Content="Close" Width="80" Height="30"
                Margin="0,15,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource BoxButtons}"
                Click="Close_Click"/>
    </Grid>
</Window>
