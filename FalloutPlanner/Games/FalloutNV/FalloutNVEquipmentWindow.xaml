<Window x:Class="FalloutPlanner.Games.FalloutNV.FalloutNVEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FalloutNVResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Equipment"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource FalloutAccentBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Coming Soon"
                           FontSize="16"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Equipment management will be available in a future update."
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Opacity="0.7"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="1"
                Content="Close"
                Margin="0,15,0,0"
                Height="35"
                Width="100"
                HorizontalAlignment="Center"
                Style="{StaticResource BoxButtons}"
                Click="Close_Click"/>
    </Grid>
</Window>
