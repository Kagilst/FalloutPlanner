<Window x:Class="FalloutPlanner.Games.FalloutNV.TagSkillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag!"
        Height="480"
        Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Choose a skill to Tag (+15)"
                   FontWeight="Bold"
                   FontSize="14"
                   Foreground="{DynamicResource FalloutAccentBrush}"
                   Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SkillButtons" />
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Cancel"
                Margin="0,12,0,0"
                Height="32"
                HorizontalAlignment="Right"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Cancel_Click" />
    </Grid>
</Window>
