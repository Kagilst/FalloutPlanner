<Window x:Class="FalloutPlanner.Games.FalloutNV.FalloutNVTraitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Traits (0-2)"
        Height="560"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FalloutNVResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TraitCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Character Setup"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"/>

            <!-- Gender Selection -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Gender: "
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
                <RadioButton Content="Male"
                             GroupName="Gender"
                             IsChecked="{Binding IsMale}"
                             Foreground="{DynamicResource FalloutTextBrush}"
                             Margin="8,0,0,0"
                             VerticalAlignment="Center"/>
                <RadioButton Content="Female"
                             GroupName="Gender"
                             IsChecked="{Binding IsFemale}"
                             Foreground="{DynamicResource FalloutTextBrush}"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="Traits"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"
                       Margin="0,12,0,0"/>
            <TextBlock Text="You may choose 0, 1, or 2 traits for your character."
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedCountText}"
                       Margin="0,4,0,0"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Trait List -->
            <Border BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="8"
                    Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TraitChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Trait.Name}"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}"
                                          Style="{StaticResource TraitCheckBox}"
                                          Checked="Trait_CheckChanged"
                                          Unchecked="Trait_CheckChanged"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Trait Details -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTrait.Name}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="Benefit:"
                                   Margin="0,12,0,4"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource FalloutAccentBrush}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SelectedTrait.Benefit}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="Penalty:"
                                   Margin="0,12,0,4"
                                   FontWeight="Bold"
                                   Foreground="#FF6B4A"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SelectedTrait.Penalty}"
                                   TextWrapping="Wrap"
                                   Foreground="#FFB090"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="Click a trait to see its details."
                                   FontStyle="Italic"
                                   Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="35"
                    Margin="0,0,8,0"
                    Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click"/>
            <Button Content="Confirm"
                    Width="100"
                    Height="35"
                    Style="{StaticResource BoxButtons}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
