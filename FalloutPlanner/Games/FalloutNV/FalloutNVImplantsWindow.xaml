<Window x:Class="FalloutPlanner.Games.FalloutNV.FalloutNVImplantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Implants"
        Height="560"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FalloutNVResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ImplantListBox" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource FalloutPanelBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FalloutBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}" />
            </Style>

            <Style x:Key="ImplantListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2A1A0A" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with slot info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Implants"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"/>
            <TextBlock Text="{Binding ImplantSlotsText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- Default Implants (Dr. Usanagi) -->
            <Border BorderBrush="{DynamicResource FalloutAccentBrush}" BorderThickness="2" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Default Implants"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DefaultImplants}"
                             SelectedItem="{Binding SelectedImplant}"
                             Style="{StaticResource ImplantListBox}"
                             ItemContainerStyle="{StaticResource ImplantListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " 
                                               Foreground="{DynamicResource FalloutAccentBrush}"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Implant.DisplayName}"
                                               Opacity="{Binding ListOpacity}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Old World Blues Implants -->
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="8"
                    Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Old World Blues"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource FalloutAccentBrush}"
                               Margin="0,0,0,8" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding OWBImplants}"
                             SelectedItem="{Binding SelectedImplant}"
                             Style="{StaticResource ImplantListBox}"
                             ItemContainerStyle="{StaticResource ImplantListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " 
                                               Foreground="{DynamicResource FalloutAccentBrush}"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding Implant.DisplayName}"
                                               Opacity="{Binding ListOpacity}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="2"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedImplant.Implant.DisplayName}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />

                            <TextBlock Text="Effect:"
                                       Margin="0,12,0,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />
                            <TextBlock Text="{Binding SelectedImplant.Implant.Description}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Unlock Condition:"
                                       Margin="0,12,0,4"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />
                            <TextBlock Text="{Binding SelectedImplant.Implant.UnlockCondition}"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="{Binding SelectedStatusText}"
                                       Margin="0,12,0,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource FalloutAccentBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="1"
                            Content="Install Implant"
                            Margin="0,12,0,0"
                            Height="35"
                            Style="{StaticResource BoxButtons}"
                            Visibility="{Binding CanInstallSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="Install_Click" />
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="Back"
                Margin="0,12,0,0"
                Height="35"
                HorizontalAlignment="Left"
                Width="100"
                Style="{StaticResource BoxButtons}"
                Click="Back_Click" />
    </Grid>
</Window>
