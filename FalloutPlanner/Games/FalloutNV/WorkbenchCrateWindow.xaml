<Window x:Class="FalloutPlanner.Games.FalloutNV.WorkbenchCrateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workbench Crate - Select Books"
        Height="480"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="FalloutNVResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BookCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource FalloutTextBrush}"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding CrateTitle}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}"/>
            <TextBlock Text="Workbench crates can contain 0-4 random skill books."
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.85"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock FontWeight="Bold"
                       Foreground="{DynamicResource FalloutAccentBrush}">
                <Run Text="Books Selected: "/>
                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                <Run Text=" / 4"/>
            </TextBlock>
            <TextBlock Text="{Binding ComprehensionNote}"
                       FontSize="11"
                       Opacity="0.75"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="2"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding BookChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding CanSelect}"
                                      Style="{StaticResource BookCheckBox}"
                                      Checked="Book_CheckChanged"
                                      Unchecked="Book_CheckChanged"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel"
                    Width="100"
                    Height="35"
                    Margin="0,0,8,0"
                    Style="{StaticResource BoxButtons}"
                    Click="Cancel_Click"/>
            <Button Content="Confirm"
                    Width="100"
                    Height="35"
                    Style="{StaticResource BoxButtons}"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
