<UserControl x:Class="FalloutPlanner.Controls.LevelSettingsButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="34" Height="28">
    <Grid>
        <Button x:Name="MenuButton"
                Click="MenuButton_Click"
                ToolTip="Settings"
                Cursor="Hand"
                Background="Transparent"
                BorderBrush="{DynamicResource FalloutAccentBrush}"
                BorderThickness="1"
                Padding="6,5">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <!-- Hamburger: three horizontal lines -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="14">
                            <Border Height="2" Margin="0,1" Background="{DynamicResource FalloutAccentBrush}"/>
                            <Border Height="2" Margin="0,1" Background="{DynamicResource FalloutAccentBrush}"/>
                            <Border Height="2" Margin="0,1" Background="{DynamicResource FalloutAccentBrush}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutPanelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FalloutAccentDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Popup x:Name="MenuPopup"
               PlacementTarget="{Binding ElementName=MenuButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource FalloutPanelBrush}"
                    BorderBrush="{DynamicResource FalloutAccentBrush}"
                    BorderThickness="1"
                    Padding="4"
                    MinWidth="120">
                <StackPanel>
                    <Button Content="Restart"
                            Style="{DynamicResource BoxButtons}"
                            Margin="0,2"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            Click="Restart_Click"/>
                    <Button Content="Home"
                            Style="{DynamicResource BoxButtons}"
                            Margin="0,2"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            Click="Home_Click"/>
                    <Button Content="Save"
                            Style="{DynamicResource BoxButtons}"
                            Margin="0,2"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            Click="Save_Click"/>
                    <Button Content="Export Guide"
                            Style="{DynamicResource BoxButtons}"
                            Margin="0,2"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            Click="ExportGuide_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
