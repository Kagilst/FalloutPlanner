<Window x:Class="FalloutPlanner.Saves.SaveNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Character"
        Height="180"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Save name" FontWeight="Bold" Margin="0,0,0,8"
                   Foreground="{DynamicResource FalloutAccentBrush}"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Height="28" Padding="4"
                 Background="{DynamicResource FalloutPanelBrush}"
                 Foreground="{DynamicResource FalloutTextBrush}"
                 BorderBrush="{DynamicResource FalloutBorderBrush}"
                 CaretBrush="{DynamicResource FalloutTextBrush}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="8,4"
                    Style="{DynamicResource BoxButtons}" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" Padding="8,4"
                    Style="{DynamicResource BoxButtons}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
