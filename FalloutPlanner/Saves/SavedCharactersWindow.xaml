<Window x:Class="FalloutPlanner.Saves.SavedCharactersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved Characters"
        Height="420"
        Width="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource FalloutBackgroundBrush}"
        Foreground="{DynamicResource FalloutTextBrush}"
        FontFamily="Consolas">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource FalloutAccentBrush}" Margin="0,0,0,10"/>

        <ListBox x:Name="SaveList" Grid.Row="1"
                 Background="{DynamicResource FalloutPanelBrush}"
                 Foreground="{DynamicResource FalloutTextBrush}"
                 BorderBrush="{DynamicResource FalloutBorderBrush}"
                 DisplayMemberPath="ListDisplay"
                 MouseDoubleClick="Load_Click"/>

        <TextBlock x:Name="EmptyText" Grid.Row="1"
                   Text="No saved characters yet."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.7" Visibility="Collapsed"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button Content="Delete" Width="90" Margin="0,0,8,0" Padding="8,4"
                    Style="{DynamicResource BoxButtons}" Click="Delete_Click"/>
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Padding="8,4"
                    Style="{DynamicResource BoxButtons}" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Load" Width="90" Padding="8,4"
                    Style="{DynamicResource BoxButtons}" IsDefault="True" Click="Load_Click"/>
        </StackPanel>
    </Grid>
</Window>
